FLASK_APP=app.py
FLASK_DEBUG=1

# Local MariaDB example. Update user/password/host/database for your server.
DATABASE_URL=mariadb+pymysql://inventory:inventory@127.0.0.1:3306/datacenter_inventory

# Change this in production.
SECRET_KEY=change-me
SESSION_COOKIE_NAME=inventory-session
SESSION_COOKIE_SECURE=0
ENABLE_HSTS=0

# Comma-separated users. Plain passwords work; Werkzeug password hashes also work.
INVENTORY_USERS=admin:admin123
